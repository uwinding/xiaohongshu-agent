# XHS Collector Configuration
# Copy this file to .env and fill in real values

# Cookie string for XHS API authentication (optional — if not set, browser QR login is used)
XHS_COOKIE=

# Collector settings (defaults provided, uncomment to override)
# COLLECTOR_HEADLESS=true
# COLLECTOR_MAX_CONCURRENCY=3
# COLLECTOR_RETRY_TIMES=3
# COLLECTOR_PAGE_TIMEOUT=30000
# COLLECTOR_MAX_NOTES_PER_KEYWORD=50
# COLLECTOR_STORAGE_STATE_PATH=data/storage_state.json
# COLLECTOR_OUTPUT_DIR=data/output
# COLLECTOR_RAW_DIR=data/raw
# COLLECTOR_XHS_DOMAIN=https://www.xiaohongshu.com
# COLLECTOR_XHS_API_HOST=https://edith.xiaohongshu.com

# LLM Configuration
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Database
# DATABASE_URL=sqlite:///data/agent.db
